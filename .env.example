# Environment Configuration
# Copy to .env and fill in real values

# ── App ─────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production
# Skip Jobber re-sync in dev when Qdrant already holds this many points (0 = always sync)
DEV_SKIP_SYNC_MIN_CHUNKS=500

# ── Database ─────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=texponse
POSTGRES_USER=texponse
POSTGRES_PASSWORD=texponse_dev

# ── Redis ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=texponse_dev
REDIS_DATABASE=0

# ── Qdrant ───────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base
QDRANT_USE_TLS=false

# ── Aircall ──────────────────────────────────
AIRCALL_API_ID=your_aircall_api_id
AIRCALL_API_TOKEN=your_aircall_api_token
AIRCALL_WEBHOOK_SECRET=your_aircall_webhook_signing_secret
# ID of the Aircall number configured for Public API messaging
# (find it via GET /v1/numbers, then configure it for messaging first)
AIRCALL_LINE_ID=
# Optional shared token to authenticate proxy-mode messaging callbacks
# (configure_number_for_messaging returns a token; pass it back as
# ?token=... or X-Aircall-Callback-Token). Empty = accept unsigned (dev only).
AIRCALL_CALLBACK_TOKEN=
# Dispatcher bypass allowlist (dev accounts — comma-separated, matched on last 10 digits)
# CHUNK_SECURITY_BYPASS_NUMBERS=+13526423004

# ── Jobber ───────────────────────────────────
JOBBER_CLIENT_ID=your_jobber_client_id
JOBBER_CLIENT_SECRET=your_jobber_client_secret
JOBBER_REDIRECT_URI=https://yourapp.com/auth/jobber/callback

# ── LLM provider: gemini (default, ~1500 free req/day) | openrouter | ollama | free-proxy ─
LLM_PROVIDER=gemini
# Gemini — free key, no card: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_FALLBACK_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120.0
FREE_PROXY_BASE_URL=http://free-llm-proxy:8080/v1
FREE_PROXY_DEFAULT_MODEL=small
FREE_PROXY_FALLBACK_MODEL=speed
FREE_PROXY_TIMEOUT=120.0
# At least one free-tier key for the proxy (env passthrough in compose):
# GROQ_API_KEY= / GEMINI_API_KEY= / GITHUB_TOKEN= / CEREBRAS_API_KEY=
# HF_API_KEY= / MISTRAL_API_KEY= / NVIDIA_API_KEY= / COHERE_API_KEY=
# ── OpenRouter (only needed when LLM_PROVIDER=openrouter) ────────────
OPENROUTER_API_KEY=sk-or-vj-your-openrouter-key
OPENROUTER_DEFAULT_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
